//**Box blur uses 1/9 with a kernal of all ones*/

void blur(){

    string namee;
    cout << "Which photo would you like to do the changes in, make sure you chose the image with the right filename and extension." << endl;
    cin >> namee;
    Image pic(namee);
    int radius;
    cout << "eneter blur intensiy (note for quick testing dont go over 5) ";
    cin >> radius;
    Image blured(pic.width +(2 * radius), pic.height + (2 * radius));
    int sum=0;
    int k_area = (2*radius + 1)*(2*radius + 1);

        for (int x = 0; x < pic.width; x++) {
            for (int y = 0; y < pic.height; y++) {
                for (int k = 0; k < pic.channels; k++) {
                    blured(x + radius, y + radius, k) = pic(x, y, k);
                }
            }
        }

    for (int i = radius; i < blured.width - radius; i++){
        for (int j = radius; j < blured.height - radius; j++){
            for (int k = 0; k < blured.channels; k++){
            
                int sum = 0;
                for (int x = - radius; x <= radius; x++){
                    for (int y = - radius; y <= radius; y++){
                        sum = sum + blured(i + x,j + y,k);
                    }
                }
                blured(i, j, k) = sum / k_area;
            }
        }
    }
  
    blured.saveImage("new_photo.jpeg");
}

void resize(){

    string namee;
    cout << "which photo would you like to do the changes in, make sure you chose the image with the right filename and extension." << endl;
    getline(cin, namee);
    Image pic(namee);
    int option,w,h,new_w,new_h;

    cout << "\nselect option:\n"<< "1 double sizee\n"<< "2. half size \n"<< "3. custom dimenisons\n"<< "enter option 1-3 ";
    cin >> option;

    switch (option){
        case 1:
            w = pic.width * 2;
            h = pic.height * 2;
            break;
        case 2:
            w = pic.width / 2;
            h = pic.height / 2;
            break;
        case 3:
            cout << "new width: ";
            cin >> w;
            cout << "new height ";
            cin >> h;
            break;
        default:
            cout << "Invalid\n";
            w = pic.width;
            h = pic.height;
            break;
    }
    Image cust(w,h);
    float scale_X = (float)pic.width / cust.width;
    float scale_Y = (float)pic.height / cust.height;

        for (int i = 0; i < cust.width; i++){
            for (int j = 0; j < cust.height; j++){

                float orignil_X = (float)(i * scale_X);
                float orignil_Y = (float)(j * scale_Y);

                for (int k = 0; k < pic.channels; k++){
                    cust(i, j, k) = pic(orignil_X, orignil_Y, k);
                }

            }
        }
    
    cust.saveImage("new_photo.jpeg");
}
void frame(){

    string namee;
    cout << "Which photo would you like to do the changes in, make sure you chose the image with the right filename and extension." << endl;
    getline(cin, namee);

    Image pic(namee);

    int choice, padding = 0, r = 0, g = 0, b = 0;
        do {
            cout << "Enter padding size in pixels (e.g. 500): ";
            cin >> padding;
        } while (padding < 0);
        
    padding = padding * 2;
        do {
            cout << "Select border color:\n1. Red\n2. Green\n3. Blue\n4. Custom RGB\nEnter choice (1-4): ";
            cin >> choice;
        }
        while (choice < 1 || choice > 4);

    switch (choice) {
        case 1: r = 255; break;
        case 2: g = 255; break;
        case 3: b = 255; break;
        case 4:
            do {
                cout << "Enter R G B (0-255): ";
                cin >> r >> g >> b;
            }
            while (r < 0 || r > 255 || g < 0 || g > 255 || b < 0 || b > 255);
            break;
        default:
            r = g = b = 255;
            break;
    }

    Image frame(pic.width +padding,pic.height +padding) ;

        for (int i = 0; i < frame.width; i++) {
            for (int j = 0; j < frame.height; j++) {
                frame(i, j, 0) = r;
                frame(i, j, 1) = g;
                frame(i, j, 2) = b;
            }
        }
        for (int i = 0; i < pic.width; i++) {
            for (int j = 0; j < pic.height; j++) {
                for (int k = 0; k < pic.channels; k++) {
                    frame(i + padding/2, j + padding/2, k) = pic(i, j, k);
                }
            }
        }
    frame.saveImage("new_photo.jpeg");

}

int main() {
blur();
frame();
    resize();
    return 0;
}
